PORT=4000
DATABASE_URL=postgresql://mateira:mateira@localhost:5433/mateira

# Required, at least 32 characters, must not start with "change-me". Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL=14d
BCRYPT_SALT_ROUNDS=12
# Dev over plain http only; never in production. When unset or empty the refresh cookie is Secure.
COOKIE_SECURE=false
# Number of reverse proxies in front of the app that append to X-Forwarded-For (0 = none, the header is ignored).
# Set it to the real number of proxies: the client address is the Nth entry from the right.
TRUST_PROXY_HOPS=0
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=15m

CORS_ORIGINS=http://localhost:5173

SUPERUSER_EMAIL=admin@mateira.local
# Required by the seed script (npm run seed): choose a password of at least 12 characters.
SUPERUSER_PASSWORD=

MEDIA_ENDPOINT=http://localhost:9100
MEDIA_REGION=us-east-1
MEDIA_ACCESS_KEY=minioadmin
MEDIA_SECRET_KEY=minioadmin
MEDIA_BUCKET=mateira-media
MEDIA_PUBLIC_BASE_URL=http://localhost:9100
MEDIA_FORCE_PATH_STYLE=true
MEDIA_PRESIGN_EXPIRES_IN=15m
