generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERUSER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NewsCategory {
  MATEIRA
  RICERCA
  PROGRAMMI
  VIAGGIO_TIRENAUTI
  INCONTRI
  COLLABORAZIONI
  APPUNTAMENTI
  PRESS
  COMUNICATI
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(SUPERUSER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Media {
  id             String   @id @default(uuid())
  bucket         String
  objectKey      String   @unique
  mimeType       String
  size           Int?
  alt            String?
  createdAt      DateTime @default(now())
  coverOf        News[]   @relation("NewsImage")
  attachmentOf   News[]   @relation("NewsAttachments")
  photoOf        Person[] @relation("PersonPhoto")
}

model News {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  date          DateTime
  category      NewsCategory
  body          String        @db.Text
  author        String?
  externalLinks Json          @default("[]")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  imageId       String?
  image         Media?        @relation("NewsImage", fields: [imageId], references: [id], onDelete: SetNull)
  attachments   Media[]       @relation("NewsAttachments")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
}

enum HomeBlockType {
  HERO
  TICKER
  CTA
  FEATURED
}

model HomeBlock {
  id          String        @id @default(uuid())
  type        HomeBlockType
  position    Int
  content     Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, position])
}

model Word {
  id          String        @id @default(uuid())
  term        String
  etymology   String        @db.Text
  meaning     String        @db.Text
  closing     String?
  page        String
  position    Int
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([page, term])
  @@index([page, status, position])
}

enum OrganCategory {
  GOVERNANCE
  ADVISORY
}

enum PersonRoleKind {
  PROMOTER
  TEAM
  AMBASSADOR
  ORGAN_MEMBER
}

model Organ {
  id          String        @id @default(uuid())
  name        String        @unique
  category    OrganCategory
  description String?       @db.Text
  position    Int
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roles       PersonRole[]

  @@index([category, status, position])
}

model Person {
  id          String        @id @default(uuid())
  name        String
  bio         String?       @db.Text
  photoId     String?
  photo       Media?        @relation("PersonPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roles       PersonRole[]
}

model PersonRole {
  id        String         @id @default(uuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind      PersonRoleKind
  organId   String?
  organ     Organ?         @relation(fields: [organId], references: [id], onDelete: Cascade)
  title     String?
  position  Int
  createdAt DateTime       @default(now())

  @@index([kind, organId, position])
}
