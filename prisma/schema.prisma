generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERUSER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NewsCategory {
  MATEIRA
  RICERCA
  PROGRAMMI
  VIAGGIO_TIRENAUTI
  INCONTRI
  COLLABORAZIONI
  APPUNTAMENTI
  PRESS
  COMUNICATI
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(SUPERUSER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Media {
  id                String        @id @default(uuid())
  bucket            String
  objectKey         String        @unique
  mimeType          String
  size              Int?
  alt               String?
  createdAt         DateTime      @default(now())
  coverOf           News[]        @relation("NewsImage")
  attachmentOf      News[]        @relation("NewsAttachments")
  photoOf           Person[]      @relation("PersonPhoto")
  documentFileOf    Document[]    @relation("DocumentFile")
  publicationFileOf Publication[] @relation("PublicationFile")
}

model News {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  date          DateTime
  category      NewsCategory
  body          String        @db.Text
  author        String?
  externalLinks Json          @default("[]")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  imageId       String?
  image         Media?        @relation("NewsImage", fields: [imageId], references: [id], onDelete: SetNull)
  attachments   Media[]       @relation("NewsAttachments")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
}

enum HomeBlockType {
  HERO
  TICKER
  CTA
  FEATURED
}

model HomeBlock {
  id          String        @id @default(uuid())
  type        HomeBlockType
  position    Int
  content     Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, position])
}

model Word {
  id          String        @id @default(uuid())
  term        String
  etymology   String        @db.Text
  meaning     String        @db.Text
  closing     String?
  page        String
  position    Int
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([page, term])
  @@index([page, status, position])
}

enum OrganCategory {
  GOVERNANCE
  ADVISORY
}

enum PersonRoleKind {
  PROMOTER
  TEAM
  AMBASSADOR
  ORGAN_MEMBER
}

model Organ {
  id          String        @id @default(uuid())
  name        String        @unique
  category    OrganCategory
  description String?       @db.Text
  position    Int
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roles       PersonRole[]

  @@index([category, status, position])
}

model Person {
  id          String        @id @default(uuid())
  name        String
  bio         String?       @db.Text
  photoId     String?
  photo       Media?        @relation("PersonPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  roles       PersonRole[]
}

model PersonRole {
  id        String         @id @default(uuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind      PersonRoleKind
  organId   String?
  organ     Organ?         @relation(fields: [organId], references: [id], onDelete: Cascade)
  title     String?
  position  Int
  createdAt DateTime       @default(now())

  @@unique([personId, kind, organId], map: "PersonRole_personId_kind_organId_key")
  @@index([kind, organId, position])
}

enum DocumentCategory {
  INSTITUTIONAL
  TRANSPARENCY
}

enum PublicationType {
  RESEARCH
  REPORT
  PAPER
  PUBLICATION
  DATA
  ATLAS
  SCENARIO
  CITIZEN_SCIENCE
  LIVING_ARCHIVE
}

// A file (Media) or an external URL, never both: the CHECK "Document_file_xor_url" lives only in the migration.
model Document {
  id          String           @id @default(uuid())
  title       String
  category    DocumentCategory
  section     String?
  date        DateTime
  description String?          @db.Text
  fileId      String?
  file        Media?           @relation("DocumentFile", fields: [fileId], references: [id], onDelete: SetNull)
  externalUrl String?
  status      ContentStatus    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category, status, section, date])
}

// A file (Media) or an external URL, never both: the CHECK "Publication_file_xor_url" lives only in the migration.
model Publication {
  id          String          @id @default(uuid())
  title       String
  type        PublicationType
  authors     String?
  date        DateTime
  abstract    String?         @db.Text
  fileId      String?
  file        Media?          @relation("PublicationFile", fields: [fileId], references: [id], onDelete: SetNull)
  externalUrl String?
  status      ContentStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, type, date])
}
