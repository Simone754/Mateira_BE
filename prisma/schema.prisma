generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERUSER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NewsCategory {
  MATEIRA
  RICERCA
  PROGRAMMI
  VIAGGIO_TIRENAUTI
  INCONTRI
  COLLABORAZIONI
  APPUNTAMENTI
  PRESS
  COMUNICATI
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(SUPERUSER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Media {
  id             String   @id @default(uuid())
  bucket         String
  objectKey      String   @unique
  mimeType       String
  size           Int?
  alt            String?
  createdAt      DateTime @default(now())
  coverOf        News[]   @relation("NewsImage")
  attachmentOf   News[]   @relation("NewsAttachments")
}

model News {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  date          DateTime
  category      NewsCategory
  body          String        @db.Text
  author        String?
  externalLinks Json          @default("[]")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  imageId       String?
  image         Media?        @relation("NewsImage", fields: [imageId], references: [id], onDelete: SetNull)
  attachments   Media[]       @relation("NewsAttachments")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
}
